generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id                  String             @id @default(uuid())
  fullName            String
  email               String             @unique
  mobileNumber        String
  college             String
  yearOfStudy         String
  branch              String
  linkedInProfile     String?
  declarationAccepted Boolean
  createdAt           DateTime           @default(now())
  domains             CandidateDomain[]
  session             AssessmentSession?
}

model Domain {
  id               String            @id @default(uuid())
  name             String            @unique // e.g., "Technical Team"
  questions        Question[]
  candidateDomains CandidateDomain[]
}

model CandidateDomain {
  candidateId String
  domainId    String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  domain      Domain    @relation(fields: [domainId], references: [id])

  @@id([candidateId, domainId])
}

model Question {
  id            String            @id @default(uuid())
  domainId      String
  domain        Domain            @relation(fields: [domainId], references: [id])
  text          String
  options       String[]          // Array of 4 options
  correctOption Int               // Index 0-3
  marks         Int               @default(1)
  candidateAns  CandidateAnswer[]
}

model AssessmentSession {
  id              String            @id @default(uuid())
  candidateId     String            @unique
  candidate       Candidate         @relation(fields: [candidateId], references: [id])
  startTime       DateTime          @default(now())
  endTime         DateTime?
  status          String            // IN_PROGRESS, COMPLETED, TERMINATED
  score           Int?
  deviceInfo      Json?             // Browser, OS, IP, User Agent
  violationsCount Int               @default(0)
  answers         CandidateAnswer[]
  violations      Violation[]
}

model CandidateAnswer {
  id            String            @id @default(uuid())
  sessionId     String
  session       AssessmentSession @relation(fields: [sessionId], references: [id])
  questionId    String
  question      Question          @relation(fields: [questionId], references: [id])
  selectedOpt   Int?              // Index 0-3
  savedAt       DateTime          @default(now())

  @@unique([sessionId, questionId])
}

model Violation {
  id          String            @id @default(uuid())
  sessionId   String
  session     AssessmentSession @relation(fields: [sessionId], references: [id])
  type        String            // BLUR, FULLSCREEN_EXIT, etc.
  timestamp   DateTime          @default(now())
  description String?
}

model AdminUser {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String
  role         String @default("ADMIN")
}
